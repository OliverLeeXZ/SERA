{
  "version": "textworld_multidish_v9_mixed_train_1500",
  "enabled": true,
  "default_task_family": "multi_dish_fork_join",
  "task_view": "structured",
  "task_view_by_difficulty": {
    "easy": "structured",
    "medium": "structured",
    "hard": "structured",
    "extreme": "coarse"
  },
  "source_db": "cooking_world.json",
  "require_disjoint_ingredients": true,
  "seed_stride": 1000003,
  "runtime_ranges": {
    "easy": {
      "shared_environment_max_steps": {
        "min": 115,
        "max": 125
      },
      "tool_cooldown_steps": {
        "choices": [
          0
        ]
      }
    },
    "medium": {
      "shared_environment_max_steps": {
        "min": 95,
        "max": 100
      },
      "tool_cooldown_steps": {
        "choices": [
          0,
          1
        ]
      }
    },
    "hard": {
      "shared_environment_max_steps": {
        "min": 75,
        "max": 90
