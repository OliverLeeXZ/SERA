      "tool_cooldown_steps": {
        "choices": [
          1
        ]
      }
    }
  },
  "task_families": {
    "multi_dish_fork_join": {
      "pattern": "fork_join",
      "description": "independent dishes with a shared finalization stage"
    },
    "critical_path": {
      "pattern": "critical_path",
      "description": "independent branches with one deliberately longer branch"
    },
    "load_balanced": {
      "pattern": "load_balanced",
      "description": "heterogeneous branch workload"
    },
    "resource_constrained": {
      "pattern": "resource_constrained",
      "shared_resources": [
        "knife",
        "stove",
        "kitchen"
      ],
      "description": "parallel branches under shared capacity and tools"
    },
    "dependency_gate": {
      "pattern": "dependency_gate",
      "gate_count": 1,
      "gate_type": "door",
      "include_doors": true,
      "description": "some branches require an access gate before execution"
    },
    "conflict": {
      "pattern": "conflict",
      "shared_resources": [
        "knife",
        "stove"
      ],
      "resource_capacity": {
        "knife": 1,
        "stove": 1
      },
      "description": "branches compete for unique shared tools"
    },
    "hierarchical": {
      "pattern": "hierarchical",
      "hierarchy_depth": 2,
      "description": "dish-level branches contain ingredient-level subbranches"
    }
  },
